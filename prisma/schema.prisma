generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Universidade {
  uuid        String   @id @default(cuid())
  nome        String
  sigla       String   @unique
  cnpj        String   @unique
  criadoEm    DateTime @default(now())
  alteradoEm  DateTime @updatedAt
}
